# Bot token (Developer Portal > Bot > Reset Token). NEVER share it.
DISCORD_TOKEN=paste_your_token_here
# Application ID (Developer Portal > General Information)
DISCORD_CLIENT_ID=your_application_id
# Optional: your server ID. With it, slash commands show up instantly.
# Without it, commands are registered globally.
DEV_GUILD_ID=

# Password for the database Docker creates (you can keep it, it's local only)
POSTGRES_PASSWORD=akali

# Only needed when running WITHOUT Docker (npm run dev)
DATABASE_URL=postgresql://akali:akali@localhost:5432/akali?schema=public

# Lofi radio stream (any MP3/AAC/Icecast stream)
LOFI_STREAM_URL=https://ice1.somafm.com/groovesalad-128-mp3

PORT=3000
LOG_LEVEL=info
