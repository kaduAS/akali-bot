{
  "name": "akali-bot",
  "version": "1.0.0",
  "description": "Akali - a Discord bot with moderation, levels, lofi radio and fun commands",
  "license": "ISC",
  "author": "Kadu",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "deploy:commands": "tsx src/deploy-commands.ts",
    "deploy:commands:prod": "node dist/deploy-commands.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "@prisma/client": "^6.0.0",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "libsodium-wrappers": "^0.7.15",
    "opusscript": "^0.0.8",
    "pino": "^9.5.0",
    "prisma": "^6.0.0",
    "prism-media": "^1.3.5",
    "zod": "^3.25.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "eslint": "^10.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0"
  }
}
